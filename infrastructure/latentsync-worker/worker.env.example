# Copy to a protected mode-0600 environment file after deployment approval.
INTERVIEW_ALLOW_LIVE_AWS=false
INTERVIEW_AWS_REGION=eu-central-1
INTERVIEW_PRIORITY_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/361769579092/mahara-interview-priority
INTERVIEW_BACKGROUND_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/361769579092/mahara-interview-background
INTERVIEW_STATUS_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/361769579092/mahara-interview-status
MINIO_ENDPOINT=minio.internal.example:443
MINIO_BUCKET=mahara-private
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
LATENTSYNC_CHECKOUT=/opt/LatentSync
LATENTSYNC_AVATAR_DIR=/opt/LatentSync
LATENTSYNC_CONDA=/opt/miniconda/bin/conda
LATENTSYNC_CONFIG=/opt/LatentSync/configs/unet/stage2_512.yaml
LATENTSYNC_CHECKPOINT=/opt/LatentSync/checkpoints/latentsync_unet.pt
LATENTSYNC_REVISION=
# Set only after inspecting the actual deployed pipeline and timing patch.
LATENTSYNC_FPS_VERIFIED=false
INTERVIEW_FFMPEG=/usr/bin/ffmpeg
INTERVIEW_VISIBILITY_SECONDS=900
INTERVIEW_HEARTBEAT_SECONDS=60
INTERVIEW_INFERENCE_TIMEOUT_SECONDS=3600
INTERVIEW_WORKER_LOCK=/var/lib/mahara-interview/worker.lock
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
