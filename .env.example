# Proposed future configuration names only; no settings loader exists yet.
# All credential values are intentionally blank. Never commit a populated .env.

# Django (set a secret locally when Django is initialized)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SETTINGS_MODULE is intentionally absent until real settings exist.

# PostgreSQL. Local Docker setup (see infrastructure/postgres/README.md):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5434/mahara_match_backup?sslmode=disable
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/mahara_match?sslmode=disable
DATABASE_URL=
TEST_DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SESSION_POOLER = 

# LLM providers for CV extraction (see docs/architecture/cv_extraction.md). With a key set, CV text
# is sent to that provider; without keys only the local Ollama model is used.
GEMINI_API_KEY=
GROQ_API_KEY=
# CV_OLLAMA_MODEL=qwen2.5:7b

# Object storage; provider and bucket provisioning are undecided
# Local docker-compose MinIO: MINIO_ENDPOINT=localhost:9000 MINIO_BUCKET=mahara-documents
# MINIO_ACCESS_KEY=minioadmin MINIO_SECRET_KEY=minioadmin (MINIO_* take precedence over OBJECT_STORAGE_*)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Derived vector index; provider and deployment topology are undecided
VECTOR_STORE_PROVIDER=
VECTOR_STORE_ENDPOINT=
VECTOR_STORE_API_KEY=

# Derived Neo4j graph
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=



# Local Ollama model used by the V1 candidate agent
OLLAMA_BASE_URL=http://172.20.144.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Embedding model served by the same Ollama host (retrieval index + queries)
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
# Candidate job tool: retrieval (default) or baseline (Phase 7 skill coverage, rollback only)
ANETAI_CANDIDATE_TOOL=retrieval
# LLM gateway; final provider/model and credentials are undecided
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

#minio object storage 
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mahara-match
MINIO_USE_SSL=false
# Mock interviews are opt-in. Mock outputs are simulated, not speech/lip-sync.
MOCK_INTERVIEW_ENABLED=false
MOCK_INTERVIEW_BACKEND=disabled
TTS_PROVIDER=disabled
STT_PROVIDER=disabled
INTERVIEW_VOICE=fr
PIPER_MODEL_PATH=
# Paid speech remains disabled; a one-off test does not enable interview calls.
ELEVENLABS_API_KEY=
INTERVIEW_PAID_TTS_ENABLED=false
# Cloud remains disabled until separately approved.
INTERVIEW_ALLOW_LIVE_AWS=false
INTERVIEW_AWS_REGION=
INTERVIEW_PRIORITY_QUEUE_URL=
INTERVIEW_BACKGROUND_QUEUE_URL=
INTERVIEW_STATUS_QUEUE_URL=
INTERVIEW_INFERENCE_REVISION=
INTERVIEW_RECORDING_RETENTION_HOURS=24
INTERVIEW_MAX_ATTEMPTS=3
FASTER_WHISPER_MODEL_PATH=
INTERVIEW_FFMPEG=ffmpeg
